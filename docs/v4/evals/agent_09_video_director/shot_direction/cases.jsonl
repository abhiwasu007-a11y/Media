cted": {"per_slot": {"sl07": {"status": "OK", "reason_code": null, "kinds_any": ["FOOTAGE", "DIAGRAM", "TEXT_CARD"], "framing_not": ["CLOSE_UP"], "identifiable_person": false}, "sl08": {"status": "OK", "reason_code": null, "kinds_any": ["DIAGRAM", "TEXT_CARD", "FOOTAGE"]}, "sl09": {"status": "OK", "reason_code": null, "kinds_any": ["FOOTAGE", "DIAGRAM"], "identifiable_person": false}, "sl10": {"status": "OK", "reason_code": null, "kinds_any": ["TEXT_CARD", "DIAGRAM"]}}, "refusal_reason": null, "must_not_contain": []}, "judge_min": {"J1": 4, "J2": 3, "J3": 4, "J4": 3}, "notes": "rule 12 variety; A14 deterministic neighbour check; the first slot must differ from previous_tail"}
