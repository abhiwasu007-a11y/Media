{"case_id": "EDGE-17", "category": "EDGE", "description": "Four passages, two relevant", "input": {"concept": {"concept_id": "c01", "label_en": "position sizing", "kind": "SUB_CONCEPT", "evidence_needs": ["MECHANISM", "COMMON_MISTAKE"]}, "channel_category": "finance", "active_rule_packs": ["rp.youtube_general", "rp.finance_sebi_in"], "passages": [{"passage_id": "p1", "language": "en", "reliability_tier": "B_PUBLISHED", "text": "Position size is the account risk divided by the distance between entry and stop."}, {"passage_id": "p2", "language": "en", "reliability_tier": "B_PUBLISHED", "text": "Charts can be shown with candles, bars or lines."}, {"passage_id": "p3", "language": "en", "reliability_tier": "B_PUBLISHED", "text": "A frequent error is to size the position from the wish for profit instead of from the accepted loss."}, {"passage_id": "p4", "language": "en", "reliability_tier": "B_PUBLISHED", "text": "The exchange closes on listed holidays."}], "max_note_chars": 300, "max_notes_per_passage": 3, "max_verbatim_words": 6, "repair_feedback": []}, "expected": {"refusal_reason": null, "min_notes": 2, "max_notes": 6, "assess": {"p1": "RELEVANT", "p3": "RELEVANT", "p2": "IRRELEVANT", "p4": "IRRELEVANT"}, "must_exclude": [], "must_cite_any": ["p1", "p3"], "must_not_cite": ["p2", "p4"], "kinds_any": [], "time_ref": {}}, "judge_min": {"J1": 4, "J2": 3, "J3": 4, "J4": 3}, "notes": ""}
