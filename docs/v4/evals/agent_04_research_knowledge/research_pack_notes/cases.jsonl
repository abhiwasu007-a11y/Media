{"case_id": "AK-01", "category": "ANSWER_KEY", "description": "Definition passage: notes in own words, cited", "input": {"concept": {"concept_id": "c01", "label_en": "stop-loss", "kind": "DEFINITION_TERM", "evidence_needs": ["DEFINITION", "COMMON_MISTAKE"]}, "channel_category": "finance", "active_rule_packs": ["rp.youtube_general", "rp.finance_sebi_in"], "passages": [{"passage_id": "p1", "language": "en", "reliability_tier": "B_PUBLISHED", "text": "A stop-loss is an order placed in advance that closes a position once price reaches a chosen level against it. Traders often move the level further away after entry, which removes the protection the order was meant to give."}], "max_note_chars": 300, "max_notes_per_passage": 3, "max_verbatim_words": 6, "repair_feedback": []}, "expected": {"refusal_reason": null, "min_notes": 1, "max_notes": 3, "assess": {"p1": "RELEVANT"}, "must_exclude": [], "must_cite_any": ["p1"], "must_not_cite": [], "kinds_any": ["DEFINITION"], "time_ref": {}}, "judge_min": {"J1": 4, "J2": 3, "J3": 4, "J4": 3}, "notes": "Copy guard NT6 applies."}
