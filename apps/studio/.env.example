# Copy to .env on the server (never commit .env). Secrets are entered there only.
AMW_SECRET_ANTHROPIC_API_KEY=
AMW_DASHBOARD_USER=owner
AMW_DASHBOARD_PASSWORD=
# Optional: free local TTS (also build with WITH_TTS=1). Hugging Face read token of an account that accepted
# the terms of ai4bharat/indic-parler-tts.
HF_TOKEN=
WITH_TTS=0
AMW_TTS_THREADS=1
# Budgets (owner decision D9) and model
AMW_BUDGET_PER_VIDEO_USD=5
AMW_BUDGET_PILOT_USD=50
AMW_LLM_MODEL=claude-opus-5-5
AMW_LLM_PRICE_IN_PER_MTOK=4
AMW_LLM_PRICE_OUT_PER_MTOK=20
# Rendering waits outside NSE market hours (D1)
AMW_BLOCK_MARKET_HOURS=1
# Resource caps for the container
AMW_PORT=8080
AMW_CPUS=1.0
AMW_MEM=2g
# Phone access. Leave CF_TUNNEL_TOKEN empty for a temporary link; fill it (and AMW_PUBLIC_URL) for a permanent one.
CF_TUNNEL_TOKEN=
AMW_PUBLIC_URL=
COMPOSE_PROFILES=quick
