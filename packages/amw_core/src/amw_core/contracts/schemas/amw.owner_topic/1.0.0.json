{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amw:schema:amw.owner_topic:1.0.0",
  "title": "AMW owner topic input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "brief",
    "angle",
    "language",
    "video_kind",
    "course_chapter_pointer",
    "owner_references",
    "target_duration_ms",
    "shorts_wanted"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "brief": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "angle": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "video_kind": {
      "enum": [
        "GENERAL",
        "METHOD_TOPIC"
      ]
    },
    "course_chapter_pointer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "owner_references": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "knowledge_source_id",
          "note"
        ],
        "properties": {
          "kind": {
            "enum": [
              "EXTERNAL_URL",
              "KNOWLEDGE_SOURCE"
            ]
          },
          "url": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "knowledge_source_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^ksr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "EXTERNAL_URL"
                }
              }
            },
            "then": {
              "properties": {
                "url": {
                  "type": "string"
                },
                "knowledge_source_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "KNOWLEDGE_SOURCE"
                }
              }
            },
            "then": {
              "properties": {
                "url": {
                  "type": "null"
                },
                "knowledge_source_id": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "target_duration_ms": {
      "type": "integer",
      "minimum": 1000
    },
    "shorts_wanted": {
      "type": "boolean"
    }
  }
}
